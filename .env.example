# Environment Configuration Example
#
# These variables are read from the process environment (os.environ).
# This file is NOT auto-loaded; export the values in your shell, e.g.:
#   Windows cmd:    set CAMERA_SOURCE=http://192.168.1.5:8080/video
#   PowerShell:     $env:CAMERA_SOURCE = "http://192.168.1.5:8080/video"
#   Linux/macOS:    export CAMERA_SOURCE=http://192.168.1.5:8080/video
# (Or use `pip install python-dotenv` and a dotenv loader if you want .env files.)

# IP camera stream URL (detect_phone.py, detect_pi.py, web_dashboard/app.py; "0" = default webcam)
CAMERA_SOURCE=http://192.168.1.100:8080/video

# Model paths (detect_pi.py; web_dashboard/app.py falls back to model/best_ncnn_model then model/best.pt)
MODEL_PATH=best.pt
NCNN_MODEL_PATH=best_ncnn_model

# Web dashboard (web_dashboard/app.py)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Required by legacy_files/download_data.py (get your own key: https://app.roboflow.com/settings/api)
ROBOFLOW_API_KEY=your-key-here
